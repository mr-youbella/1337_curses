DOMAIN_NAME=yourlogin.42.fr

MYSQL_DATABASE=wordpress
USER=yourlogin
PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Optional WordPress editor account. Defaults are used when these are omitted.
WP_USER=editor
WP_USER_PASSWORD=replace-with-a-different-strong-password
WP_USER_EMAIL=editor@example.invalid

# Pin the WordPress archive downloaded during the first initialization.
WORDPRESS_VERSION=7.1.2
WP_CLI_VERSION=2.12.0
